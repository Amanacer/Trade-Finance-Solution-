{
  "_version": "1.89.0",
  "sap.app": {
    "id": "com.sms.tradefinance.bg.bankguaranteemanagement",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.33.0",
      "toolsId": "01ffb24e-c457-4570-9ed5-7171a78f7764"
    },
    "dataSources": {
      "mainService": {
        "uri": "/bg/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "displayBGMIS": {
          "semanticObject": "BankGuarantee",
          "action": "displayMIS",
          "title": "BG MIS",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        },
        "displayBGBankLimits": {
          "semanticObject": "BankGuarantee",
          "action": "displayBankLimits",
          "title": "BG Limit Summary",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        },
        "displayBGVerticalMovement": {
          "semanticObject": "BankGuarantee",
          "action": "displayVerticalMovement",
          "title": "BG Vertical Movement",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.sms.tradefinance.bg.bankguaranteemanagement.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "BGRequestsList",
          "target": "BGRequestsList"
        },
        {
          "pattern": "BGRequests({key}):?query:",
          "name": "BGRequestsObjectPage",
          "target": "BGRequestsObjectPage"
        },
        {
          "pattern": "BGRequests({key})/approvals({key2}):?query:",
          "name": "BGApprovalsObjectPage",
          "target": "BGApprovalsObjectPage"
        },
        {
          "pattern": "BGMIS:?query:",
          "name": "BGMIS",
          "target": "BGMIS"
        },
        {
          "pattern": "BGBankLimitSummary:?query:",
          "name": "BGBankLimitSummary",
          "target": "BGBankLimitSummary"
        },
        {
          "pattern": "BGVerticalMovement:?query:",
          "name": "BGVerticalMovement",
          "target": "BGVerticalMovement"
        }
      ],
      "targets": {
        "BGRequestsList": {
          "type": "Component",
          "id": "BGRequestsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/BGRequests",
              "variantManagement": "Page",
              "navigation": {
                "BGRequests": {
                  "detail": {
                    "route": "BGRequestsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "enableExport": true
                  }
                }
              }
            }
          }
        },
        "BGRequestsObjectPage": {
          "type": "Component",
          "id": "BGRequestsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/BGRequests",
              "navigation": {
                "approvals": {
                  "detail": {
                    "route": "BGApprovalsObjectPage"
                  }
                }
              }
            }
          }
        },
        "BGApprovalsObjectPage": {
          "type": "Component",
          "id": "BGApprovalsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/BGRequests/approvals"
            }
          }
        },
        "BGMIS": {
          "type": "Component",
          "id": "BGMIS",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/BGMIS",
              "variantManagement": "Page",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": { "enableExport": true }
                }
              }
            }
          }
        },
        "BGBankLimitSummary": {
          "type": "Component",
          "id": "BGBankLimitSummary",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/BGBankLimitSummary",
              "variantManagement": "Page",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": { "enableExport": true }
                }
              }
            }
          }
        },
        "BGVerticalMovement": {
          "type": "Component",
          "id": "BGVerticalMovement",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/BGVerticalMovement",
              "variantManagement": "Page",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": { "enableExport": true }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
